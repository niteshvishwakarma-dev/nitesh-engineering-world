# Portfolio Environment Configuration (.env.example)

# Dev Server Port
PORT=3000

# JWT Authentication Secret Key (Required in production)
JWT_SECRET="replace-with-a-secure-random-secret-key-in-production"

# PostgreSQL Database Connection String (for Python FastAPI & SQLAlchemy 2.x)
# Example: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/portfolio_db"
SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio_db"

# Frontend API Base URL (leave empty for same-origin in development & production)
VITE_API_BASE_URL=""

# Verified User Details
USER_FULL_NAME="Nitesh Vishwakarma"
USER_EMAIL="niteshvishwakarma7267980881@gmail.com"
USER_GITHUB="https://github.com/niteshvishwakarma-dev"
GITHUB_USERNAME="niteshvishwakarma-dev"
